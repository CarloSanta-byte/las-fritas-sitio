/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/staff.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/apps-script/*
  X-Robots-Tag: noindex, nofollow
/tests/*
  X-Robots-Tag: noindex, nofollow
